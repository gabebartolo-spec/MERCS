{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storylets",
  "description": "data/storylets.json (or one file per batch in data/storylets/); ids are unique across all of them. A storylet has a trigger (hook, min_day, location_kinds), cast roles with tag requirements (sim/story/tags.gd), one visible check (die_sides, difficulty, attempts: who may attempt, with which stat) and two branches, success and a fail-forward failure, each a line_key and effects: {kind memory, role, key, about_role} or {kind xp, role, amount}. Text keys are in data/text/en.json.",
  "type": "object",
  "required": ["storylets"],
  "additionalProperties": false,
  "properties": {
    "storylets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^st_[a-z0-9]+(_[a-z0-9]+)*$"},
          "placeholder": {"type": "boolean"},
          "title_key": {"$ref": "#/$defs/text_key"},
          "scene_key": {"$ref": "#/$defs/text_key"},
          "once": {"type": "boolean"},
          "cooldown_days": {"type": "integer", "minimum": 0},
          "trigger": {
            "type": "object",
            "required": ["hook"],
            "additionalProperties": false,
            "properties": {
              "hook": {"type": "string", "pattern": "^(rest|arrival)$"},
              "min_day": {"type": "integer", "minimum": 0},
              "location_kinds": {"type": "array", "items": {"type": "string", "pattern": "^(hub|hamlet|wild)$"}}
            }
          },
          "cast": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role"],
              "additionalProperties": false,
              "properties": {
                "role": {"type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"},
                "require": {"type": "array", "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "check": {
            "type": "object",
            "required": ["die_sides", "difficulty", "attempts"],
            "additionalProperties": false,
            "properties": {
              "die_sides": {"type": "integer", "minimum": 2},
              "difficulty": {"type": "integer", "minimum": 0},
              "attempts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["role", "stat"],
                  "additionalProperties": false,
                  "properties": {
                    "role": {"type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"},
                    "stat": {"type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"},
                    "label_key": {"$ref": "#/$defs/text_key"}
                  }
                }
              }
            }
          },
          "success": {"$ref": "#/$defs/branch"},
          "failure": {"$ref": "#/$defs/branch"}
        }
      }
    }
  },
  "$defs": {
    "text_key": {"type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"},
    "branch": {
      "type": "object",
      "required": ["line_key", "effects"],
      "additionalProperties": false,
      "properties": {
        "line_key": {"$ref": "#/$defs/text_key"},
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "role"],
            "additionalProperties": false,
            "properties": {
              "kind": {"type": "string", "pattern": "^(memory|xp)$"},
              "role": {"type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"},
              "key": {"$ref": "#/$defs/text_key"},
              "about_role": {"type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"},
              "amount": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
