{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Equipment",
  "description": "Generic gear (D-066): weapons (wpn_), armour (arm_) and trinkets (trk_), for stats only. data/equipment.json. slot is the generic-gear slot it fills; bonus maps a merc stat to the number it adds.",
  "type": "object",
  "required": ["equipment"],
  "additionalProperties": false,
  "properties": {
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "slot", "bonus"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^(wpn|arm|trk)_[a-z0-9]+(_[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "slot": {"type": "string", "pattern": "^(weapon|armour|trinket)$"},
          "bonus": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hp": {"type": "integer"},
              "attack": {"type": "integer"},
              "defense": {"type": "integer"},
              "damage": {"type": "integer"},
              "initiative": {"type": "integer"},
              "presence": {"type": "integer"}
            }
          }
        }
      }
    }
  }
}
