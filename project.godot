; Engine configuration file (Godot 4.7.2).
; MERCS. The [debug] block makes the typing warnings errors: an untyped declaration
; or an unsafe access does not compile. tests/run_smoke_tests.gd fails if any of
; them is relaxed, if the autoloads are not exactly these six (04_GUARDRAILS.md B8),
; or if the renderer or the 1920x1080 viewport changes.

config_version=5

[application]

config/name="MERCS"
run/main_scene="res://ui/screens/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Rng="*res://presentation/autoload/rng.gd"
GameData="*res://presentation/autoload/game_data.gd"
EventBus="*res://presentation/autoload/event_bus.gd"
SaveSystem="*res://presentation/autoload/save_system.gd"
Settings="*res://presentation/autoload/settings.gd"
Debug="*res://presentation/autoload/debug.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[rendering]

renderer/rendering_method="forward_plus"
