# Text defaults first; later, more specific rules override.
* text=auto eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.bat text eol=crlf

# Binary assets go to LFS.
*.png  filter=lfs diff=lfs merge=lfs -text
*.glb  filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.ttf  filter=lfs diff=lfs merge=lfs -text
*.otf  filter=lfs diff=lfs merge=lfs -text
# Should never be committed; this rule is a tripwire.
*.safetensors filter=lfs diff=lfs merge=lfs -text

# Small review images stay plain git.
docs/**/*.png -filter -diff -merge
assets/golden/*.png -filter -diff -merge
# Pipeline test fixtures: CI checks out without LFS and the pipeline self-test reads these.
tests/fixtures/pipeline/**/*.png -filter -diff -merge
# Engine sprite sheets (pixel art, kilobytes each): plain git, so CI's checkout (no LFS) and
# the exported build get the real PNGs and runs cost no LFS bandwidth. Big binaries stay LFS.
assets/sprites/**/*.png -filter -diff -merge
# Look-target sprites and palette swatches: the same reason (the assets suite and the pixel lint
# read them in CI). The look-target .glb kits stay LFS (only the local capture tool loads them).
assets/look_target/**/*.png -filter -diff -merge
assets/palette/**/*.png -filter -diff -merge

# Pixel validator fixtures (validate_pixels.py reads these)
tests/fixtures/pixels/**/*.png -filter -diff -merge

# Fonts are binary.
*.ttf binary
